# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# syllabus source PDFs (maps live in data/syllabus/*.md)
/data/syllabus/*.pdf

# misc
.DS_Store
.idea
.cursor/
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Langfuse seed / experiment run artefacts
/langfuse/evals/.tmp
/langfuse/evals/seed-report.json
/langfuse/evals/experiment-report.json
/langfuse/evals/compare-routing-report.json

# local prompt logs
/logs
/promptfoo/tests.generated.json
/promptfoo/*.json
!/promptfoo/baseline.json
/promptfoo/*.html
/promptfoo/*.csv
/promptfoo/*.xml

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
