# Copy to .env.local. Never commit real keys. Never prefix secrets with NEXT_PUBLIC_.
# Required vs optional is noted on each block.

# --- Chat, embeddings, Guardrail LLM, evals (OpenAI) — REQUIRED for tutor turns ---
# POST /api/chat refuses to start without this. Embeddings (text-embedding-3-small)
# reuse the same key. Guardrail and the eval judge use OPENAI_MODEL.
OPENAI_API_KEY=
# Shared fallback when an agent model below is unset (default gpt-4o).
OPENAI_MODEL=gpt-4o
# One model per tutor agent. Unset falls back to OPENAI_MODEL, then gpt-4o.
# A known Gemini id (gemini-2.5-flash, gemini-2.5-pro, gemini-2.5-flash-lite)
# needs a Gemini key. Other ids are sent to OpenAI, including dated snapshots.
# ORCHESTRATION_MODEL=gpt-4o
# MATH_MODEL=gpt-4o
# PHYSICS_MODEL=gpt-4o
# CHEMISTRY_MODEL=gpt-4o
# TESTING_MODEL=gpt-4o
# Optional dated pin for Math when its selected model is that alias.
# MATH_MODEL_SNAPSHOT=gpt-4o-2024-08-06

# --- Auth / persistence (Supabase) — optional for guest chat; required for login & history ---
# Project: Sem 4 Practice Module
# Dashboard: https://supabase.com/dashboard/project/psjxfthrmqegxotokkdf
SUPABASE_URL=https://psjxfthrmqegxotokkdf.supabase.co
# Create-account / sign-in need a public key (publishable or legacy anon JWT).
# Do not paste these into SUPABASE_SERVICE_ROLE_KEY — Auth Admin rejects
# non-JWT Bearers with "This endpoint requires a valid Bearer token".
SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY=
# Optional privileged key for evals persist, Guardrail alerts, RLS bypass
# (service_role JWT or sb_secret_).
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

# --- Gemini — optional; eval Scores picker / LLM-as-judge when a Google model is selected ---
GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# --- Langflow — optional prompt logging / flow traces (chat still works without it) ---
# Start with: docker compose -f langflow/docker-compose.yml up
LANGFLOW_URL=http://localhost:7860
LANGFLOW_API_KEY=
LANGFLOW_LOGGER_FLOW_ID=

# --- Guardrail email — optional; in-app /admin alerts still store without these ---
# METS_ADMIN_EMAILS is notify-only — it does not open /admin.
# /admin is Auth app_metadata.role === "admin" (no env password / allowlist).
METS_ADMIN_EMAILS=
METS_PARENT_NOTIFY_EMAIL=
# Optional Resend (leave unset to keep alerts in-app only)
# RESEND_API_KEY=
# RESEND_FROM=

# --- Langfuse — optional catalog sync (npm run langfuse:seed-evals). Chat is not traced. ---
# CLI reads LANGFUSE_HOST; LANGFUSE_BASE_URL is an alias.
# Set LANGFUSE_HOST to your Langfuse project host (cloud or self-hosted).
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=
# LANGFUSE_BASE_URL=

# --- TypeSafe Jev — optional fast classifier for routing and Guardrail ---
# When set, routeStudentTurn and classifyStudentTurn ask Jev first.
# Unset keeps the existing LLM + keyword fallback so local / CI still work.
TYPESAFE_API_KEY=
# Optional pin (default jev-1.13.0). Thresholds are tuned against this version.
# TYPESAFE_MODEL=jev-1.13.0

